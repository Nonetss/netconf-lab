{
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "always"
    }
  },
  "python.analysis.typeCheckingMode": "basic",
  "python.testing.unittestEnabled": false,
  "[dockerfile]": {
    "editor.defaultFormatter": "ms-azuretools.vscode-containers"
  },
  "[dockercompose]": {
    "editor.defaultFormatter": "ms-azuretools.vscode-containers"
  },
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/.venv": true,
    ".claude": true,
    ".agents": true
  },
  "files.watcherExclude": {
    "**/.venv/**": true
  },
  "search.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/.venv": true,
    ".claude": true,
    ".agents": true
  },
  "[xml]": {
    "editor.defaultFormatter": "PrateekMahendrakar.prettyxml",
    "editor.formatOnSave": true
  },
  "[yaml]": {
    "editor.wordBasedSuggestions": "off",
    "editor.suggest.showWords": false
  },
  "yaml.completion": true,
  "yaml.validate": true,
  "yaml.hover": true,
  "yaml.schemaStore.enable": false,
  "yaml.schemas": {
    "./device/init/interfaz/interfaces.schema.json": [
      "device/init/interfaz/interfaces.yaml",
      "device/init/interfaz/interfaces.example.yaml"
    ],
    "./device/init/vlan/vlan.schema.json": [
      "device/init/vlan/vlan.yaml",
      "device/init/vlan/vlan.example.yaml"
    ]
  }
}