# Copia este fichero a .env y ajusta los valores si lo necesitas.

# Puerto en el host que se mapea al 830/tcp (NETCONF) del contenedor device.
NETCONF_PORT=830

# Imagen base de Netopeer2, fijada por digest para builds reproducibles.
NETOPEER2_IMAGE=sysrepo/netopeer2@sha256:efc408c392a2970f211227ba3a79fe157281e3d2914b8c4298095e6be4f4fe91
